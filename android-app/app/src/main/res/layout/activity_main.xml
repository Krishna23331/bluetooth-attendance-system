<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pacbas_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/pacbas_text_primary"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textSize="13sp"
                android:textColor="@color/pacbas_text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Server IP Settings Quick Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonServerConfig"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/pacbas_primary"
            android:text="Server"
            android:textSize="12sp"
            android:textColor="@color/pacbas_primary"
            app:cornerRadius="20dp" />
    </RelativeLayout>

    <!-- Student ID Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/pacbas_card_stroke"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/pacbas_surface"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/student_id_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/pacbas_text_secondary"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/pacbas_primary"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/pacbas_primary"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/student_id_hint"
                    android:inputType="textCapCharacters"
                    android:textSize="16sp"
                    android:textColor="@color/pacbas_text_primary"
                    android:paddingVertical="12dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Radar Scan Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonScan"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:layout_marginEnd="8dp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_radar"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:text="@string/start_scan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/pacbas_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonStopScan"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:cornerRadius="14dp"
            android:enabled="false"
            android:text="@string/stop_scan"
            android:textSize="14sp"
            android:textAllCaps="false"
            app:strokeColor="@color/pacbas_card_stroke"
            android:textColor="@color/pacbas_text_secondary" />
    </LinearLayout>

    <!-- Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/imageRadarStatus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_radar"
            app:tint="@color/pacbas_text_muted"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/textScanStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scanning_status_idle"
            android:textSize="13sp"
            android:textColor="@color/pacbas_text_secondary" />

        <TextView
            android:id="@+id/textServerHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="192.168.1.42:3000"
            android:textSize="11sp"
            android:textColor="@color/pacbas_text_muted" />
    </LinearLayout>

    <!-- Beacons Container with Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_empty_radar"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/pacbas_text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_subtitle"
                android:textSize="13sp"
                android:textColor="@color/pacbas_text_muted"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>

        <!-- Beacons RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBeacons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

</LinearLayout>
